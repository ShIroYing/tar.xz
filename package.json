{
	"name": "tar.xz",
	"private": true,
	"license": "File-to-Downloader",
	"type": "module",
	"scripts": {
		"dev:wasm": "wasm-pack build native --target bundler --out-dir ../src/wasm --out-name tar_xz",
		"dev": "bun run dev:wasm && astro dev",
		"build:wasm": "wasm-pack build native --target bundler --out-dir ../src/wasm --out-name tar_xz --release",
		"build": "bun run build:wasm && astro build",
		"preview": "astro preview",
		"prepare": "astro sync",
		"check": "cargo clippy --manifest-path native/Cargo.toml && bun run dev:wasm && astro check",
		"format": "vp fmt && prettier --write '**/*.astro' && leptosfmt --experimental-tailwind native/src && cargo fmt --manifest-path native/Cargo.toml"
	},
	"dependencies": {
		"astro": "^7.0.7",
		"astro-seo": "^1.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/sitemap": "^3.7.3",
		"@tailwindcss/vite": "^4.3.2",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"astro-html-minifier-next": "^4.0.2",
		"astro-robots": "^2.3.1",
		"prettier": "^3.9.5",
		"prettier-plugin-astro": "^0.14.1",
		"rollup": "^4.62.2",
		"tailwindcss": "^4.3.2",
		"typescript": "6.0.3",
		"vite-plugin-top-level-await": "^1.6.0",
		"vite-plugin-wasm": "^3.6.0",
		"vite-plus": "^0.2.4"
	}
}